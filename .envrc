# ENVRC FILE

### ADD PATH TO RPI FORK OF OPENOCD REPO PATH HERE ###
export OPENOCD_PATH="${OPENOCD_PATH:-$HOME/tmp/pico/openocd}"

# Verify OpenOCD repo exists
if [ ! -d "$OPENOCD_PATH" ]; then
    echo "ERROR: OpenOCD repo not found at:"
    echo "  $OPENOCD_PATH"
    return 1
fi

### DO NOT CHANGE ###
export PATH="$OPENOCD_PATH/src:$PATH"

layout python3

if [ -f requirements.txt ]; then
    pip install -r requirements.txt
fi

export VENV_PY=$(which python3)
